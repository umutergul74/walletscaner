{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@memecoin-alpha/shared": ["packages/shared/src/index.ts"],
      "@memecoin-alpha/config": ["packages/config/src/index.ts"],
      "@memecoin-alpha/core": ["packages/core/src/index.ts"],
      "@memecoin-alpha/providers": ["packages/providers/src/index.ts"],
      "@memecoin-alpha/scoring": ["packages/scoring/src/index.ts"],
      "@memecoin-alpha/backtesting": ["packages/backtesting/src/index.ts"],
      "@memecoin-alpha/paper-trading": ["packages/paper-trading/src/index.ts"],
      "@memecoin-alpha/db": ["packages/db/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "scripts/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", ".next", "dist"]
}

